// Criação
display_time = 120; // Duração de cada logo visível (sem fade)
fade_speed = 0.02; // Velocidade do fade in/out

// Variáveis de controle
time_counter = 0; // Contador de tempo
logo_index = 0; // Índice do logo atual
alpha = 0; // Transparência inicial
fading_in = true; // Controle de fade in/out
transitioning = false; // Controle de transição

// Lista de logos (sprites)
logos = [sprite_logo0,sprite_logo1, sprite_logo2, sprite_logo3,sprite_logo4]; // Adicione seus sprites aqui
